# Speechos environment variables
# Copy this file to .env and fill in the values (dev.ps1 loads .env automatically).
#
#   cp .env.example .env

# Hugging Face token — needed for gated models such as pyannote speaker diarization.
# Get one at https://huggingface.co/settings/tokens and accept the model terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1
# Without access, diarization falls back to Resemblyzer automatically.
HF_TOKEN=hf_your_token_here

# Override the hardware tier (optional, default: auto-detect)
# SPEECHOS_TIER=gpu-24gb

# Override the compute mode (optional: gpu | cpu | hybrid, default: auto)
# SPEECHOS_COMPUTE_MODE=cpu

# Override a single model (optional)
# SPEECHOS_STT_MODEL=large-v3
